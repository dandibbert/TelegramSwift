+/// Read-only discovery. A successful forum listing is authoritative evidence;
+/// a bot name or local preference is not. This never fabricates create rights.
+public func refreshBotForumCapability(account: Account, peerId: PeerId) -> Signal<Void, NoError> {
+    return account.postbox.transaction { transaction -> Api.InputPeer? in
+        guard let user = transaction.getPeer(peerId) as? TelegramUser, user.botInfo != nil else { return nil }
+        return apiInputPeer(user)
+    } |> mapToSignal { input -> Signal<Void, NoError> in
