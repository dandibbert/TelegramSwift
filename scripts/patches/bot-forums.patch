+        |> map(Optional.init)
+        |> `catch` { _ -> Signal<Api.messages.ForumTopics?, NoError> in .single(nil) }
+        |> mapToSignal { result -> Signal<Void, NoError> in
+            guard let result = result, case let .forumTopics(_, _, _, _, chats, users, _) = result else { return .complete() }
+            return account.postbox.transaction { transaction in
+                updatePeers(transaction: transaction, accountPeerId: account.peerId,
+                    peers: AccumulatedPeers(transaction: transaction, chats: chats, users: users))
+                guard let user = transaction.getPeer(peerId) as? TelegramUser, let bot = user.botInfo else { return }
+                var flags = bot.flags
+                flags.insert(.hasForum)
+                let updated = user.withUpdatedBotInfo(BotUserInfo(flags: flags, inlinePlaceholder: bot.inlinePlaceholder))
+                transaction.updatePeersInternal([updated], update: { _, value in value })
+            }
+        }
+    }
+}
